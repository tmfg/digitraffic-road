<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        Temporary suppressions, check and update these periodically
    -->

    <suppress until="2026-11-01">
        <notes><![CDATA[file name: httpcore5-5.4.2.jar]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents\.core5/httpcore5@.*$</packageUrl>
        <cpe>cpe:/a:apache:httpcomponents_core</cpe>
    </suppress>

    <suppress until="2026-11-01">
        <notes><![CDATA[file name: httpcore5-h2-5.4.2.jar]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents\.core5/httpcore5-h2@.*$</packageUrl>
        <cpe>cpe:/a:apache:httpcomponents_core</cpe>
    </suppress>

    <suppress until="2027-02-01">
        <notes><![CDATA[swagger-ui-5.32.2.jar: DOMPurify. Not exploitable here: swagger-ui does not use
        IN_PLACE mode or setConfig, and only shows our own API spec. Remove when springdoc
        brings swagger-ui >= 5.34.1.]]></notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cve>CVE-2026-116803</cve>
        <cve>CVE-2026-65898</cve>
    </suppress>

    <!--
    Permanent suppressions
    -->

    <!-- In Eclipse Paho Go MQTT v3.1 library (paho.mqtt.golang) versions <=1.5.0 UTF-8 encoded
    strings, passed into the library, may be incorrectly encoded if their length exceeds 65535
    bytes.
         Hopefully we are not doing that big payloads and if we are, we have ticket to update to new client -->
    <suppress>
        <notes><![CDATA[file name: org.eclipse.paho.client.mqttv3-1.2.5.jar]]></notes>
        <packageUrl regex="true">
            ^pkg:maven/org\.eclipse\.paho/org\.eclipse\.paho\.client\.mqttv3@.*$</packageUrl>
        <cve>CVE-2025-10543</cve>
    </suppress>
</suppressions>
